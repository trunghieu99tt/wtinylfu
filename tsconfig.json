{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": ".",
        "declaration": true,
        "sourceMap": true,
        "strictNullChecks": false
    },
    "include": ["*.ts", "min-increment-cbf.ts", "data_structure/*.ts"],
    "exclude": ["node_modules", "**/*.test.ts"]
}
